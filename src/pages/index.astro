        /* La fente du fader. */
        .fader::before {
            content: "";
            position: absolute;
            inset: var(--demi) auto;
            right: calc(var(--axe) - 1px);
            width: 2px;
            background: currentColor;
            opacity: 0.35;
            transition: opacity 0.3s;
        }

        .fader-trait,
        .fader-cues :global(li),
        .fader-bouton {
            position: absolute;
            top: calc(var(--demi) + var(--p) * (100% - 2 * var(--demi)));
            translate: 0 -50%;
        }

        .fader-trait {
            right: calc(var(--axe) - 5px);
            width: 10px;
            height: 1px;
            background: currentColor;
            opacity: 0.4;
            transition: opacity 0.3s;
        }

        .fader-trait:nth-child(5n + 1) {
            right: calc(var(--axe) - 8px);
            width: 16px;
            opacity: 0.75;
        }

        .fader-cues {
            position: absolute;
            inset: 0;
            margin: 0;
            padding: 0;
            list-style: none;
            pointer-events: none;
            font-size: 0.75rem;
            line-height: 1;
            white-space: nowrap;
        }

        /* Chaque cue est un lien vers sa phase : une main au survol, une zone de clic large.
           Au survol, le texte avance par la marge intérieure : la zone de clic, ancrée à droite,
           ne fait que s'agrandir et le survol ne clignote pas. */
        .fader-cues :global(li) {
            right: calc(var(--axe) + 12px);
            padding: 8px 6px;
            opacity: 0.5;
            cursor: pointer;
            pointer-events: auto;
            transition:
                opacity 0.3s,
                padding 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .fader-cues :global(li.active),
        .fader-cues :global(li:hover) {
            opacity: 1;
        }

        .fader-cues :global(li:hover) {
            padding-right: 10px;
        }

        /* Au survol de la course, un voile flouté se pose derrière le fader pour le détacher
           de la page. */
        .fader-voile {
            position: absolute;
            z-index: -1;
            inset: -20px -48px -20px -20px;
            background: color-mix(in srgb, var(--c-fond) 45%, transparent);
            backdrop-filter: blur(10px);
            mask-image: linear-gradient(to left, #000 55%, transparent);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.35s;
        }

        /* La visée : au survol, le niveau où un clic amènerait la page. */
        .fader-visee {
            position: absolute;
            top: var(--y, 0);
            left: 0;
            right: calc(var(--axe) - 10px);
            height: 1px;
            background: currentColor;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
        }

        /* Le bouton : un plot à l'encre de la phase, strié pour la prise, barré de sa lumière. */
        .fader-bouton {
            right: calc(var(--axe) - 13px);
            width: 26px;
            height: calc(2 * var(--demi));
            background: var(--c-encre);
            cursor: grab;
            transition:
