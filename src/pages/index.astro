---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import monogramme from "../assets/monogramme.svg?raw";
import Layout from "../layouts/Layout.astro";

const projets = (await getCollection("projets")).sort((a, b) => a.data.ordre - b.data.ordre);
const rendus = await Promise.all(
    projets.map(async (p) => ({ ...p, Contenu: (await render(p)).Content })),
);

const liens = [
    { label: "GitHub", valeur: "Cohozen", href: "https://github.com/Cohozen" },
    {
        label: "LinkedIn",
        valeur: "corentin--le--gal",
        href: "https://www.linkedin.com/in/corentin--le--gal/",
    },
    { label: "Email", valeur: "corentin.legal@proton.me", href: "mailto:corentin.legal@proton.me" },
];

const stack = [
    { quand: "Tous les jours", quoi: "TypeScript, Node.js, React, NestJS" },
    { quand: "Depuis le début", quoi: "C#, .NET Core, SQL" },
    { quand: "Mobile", quoi: "Expo, React Native, Android natif" },
    { quand: "Cloud", quoi: "AWS, Azure, Docker, Kubernetes" },
    { quand: "Données", quoi: "PostgreSQL, MongoDB, SQL Server" },
    {
        quand: "En ce moment",
        quoi: "LLM en production, agents de code, développement guidé par les specs",
    },
];

const parcours = [
    {
        annees: "2015 – 2017",
        maison: "ILTR",
        role: "Analyste développeur",
        note: "Applications métier pour les collectivités, et la formation de leurs utilisateurs, sur site et au téléphone.",
    },
    {
        annees: "2017 – 2021",
        maison: "Comerso",
        role: "Développeur DevOps",
        note: "Gestion des dons et suivi de la chaîne du froid. Migration d'OVH vers Azure, bibliothèque de composants React pour toute l'équipe, applications Android avec scan et sonde NFC.",
    },
    {
        annees: "2021 – 2022",
        maison: "KS2",
        role: "Développeur fullstack",
        note: "Traitement documentaire par OCR. J'ai remplacé un back-end en briques MVC par une API .NET Core en couches, couverte à plus de 95 % par les tests.",
    },
    {
        annees: "2022 – 2026",
        maison: "eKonsilio",
        role: "Lead développeur",
        note: "Messagerie temps réel entre entreprises et clients, des milliers de conversations par jour. J'ai encadré six à neuf développeurs, divisé par trois le temps de réponse de l'API et migré toute la stack Node.js sans interruption de service.",
    },
];

// Échelle du fader : un trait tous les 5 %, un trait long tous les 25 %.
const graduations = Array.from({ length: 21 }, (_, i) => i / 20);

const fleche = `<svg class="fleche" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5.5 3H13v7.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`;
const descendre = `<svg class="fleche" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`;
---

<Layout
    title="Corentin Le Gal, développeur"
    description="Développeur depuis 2015 : TypeScript, Node.js et .NET, du back-end au mobile. Parcours, stack et projets, dont TryCast."
>
    <a class="evitement" href="#contenu">Aller au contenu</a>

    <div class="console">
        <p class="conduite" aria-hidden="true">
            <span class="conduite-q">LX 1</span>
        </p>
        <!-- Le fader de la console remplace la barre de défilement : la course va de la nuit
             (en haut) au plein jour (en bas), chaque phase est une cue sur la course. -->
        <div
            class="fader"
            role="scrollbar"
            aria-controls="contenu"
            aria-orientation="vertical"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-label="Position dans la page"
        >
            {graduations.map((p) => <span class="fader-trait" style={`--p: ${p}`} />)}
            <span class="fader-voile" aria-hidden="true"></span>
            <ol class="fader-cues" aria-hidden="true"></ol>
            <span class="fader-visee" aria-hidden="true"></span>
            <span class="fader-bouton" aria-hidden="true"></span>
        </div>
    </div>

    <header class="nuit" data-phase="nuit">
        <a class="marque" href="/" aria-label="Corentin Le Gal, accueil" set:html={monogramme} />
        <canvas class="ciel" aria-hidden="true"></canvas>
        <div class="lumiere-horizon" aria-hidden="true">
            <div class="nappe"></div>
            <div class="poursuite"></div>
        </div>
        <div class="sol" aria-hidden="true"></div>

        <div class="wrap scene">
            <h1>Corentin Le Gal</h1>
            <div class="sous-horizon">
                <p class="qui">
                    Développeur depuis 2015. TypeScript, Node.js et .NET, du back-end au mobile. Basé
                    à Angers.
                </p>
                <ul class="reperes" role="list">
                    {
                        liens.map((l, i) => (
                            <li>
                                <a href={l.href} rel={l.href.startsWith("http") ? "me noopener" : undefined}>
                                    <span class="repere-label">
                                        <span class="repere-num">1.{i + 1}</span>
                                        {l.label}
                                    </span>
                                    <span class="repere-valeur">
                                        {l.valeur}
                                        <Fragment set:html={fleche} />
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                    <li>
                        <a href="#projets">
                            <span class="repere-label">
                                <span class="repere-num">1.4</span>
                                Projet
                            </span>
                            <span class="repere-valeur">
                                TryCast
                                <Fragment set:html={descendre} />
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <main id="contenu">
        <section class="phase cobalt" data-phase="cobalt" aria-labelledby="t-metier">
            <div class="wrap grille">
                <h2 id="t-metier">Je construis des logiciels de bout en bout</h2>
                <div class="metier-texte">
                    <p class="lead">
                        Onze ans de code, dont quatre comme lead développeur sur une plateforme SaaS
                        temps réel à forte volumétrie.
                    </p>
                    <p>
                        J'aime entrer dans une base de code existante, comprendre ses contraintes,
                        puis la faire avancer sans rien casser : migrations sans interruption,
                        performances, refontes d'architecture. Et laisser derrière moi une équipe qui
                        connaît son code mieux qu'à mon arrivée.
                    </p>
                </div>
                <dl class="plan-de-feux">
                    {
                        stack.map((s) => (
                            <div class="feu">
                                <dt>{s.quand}</dt>
                                <dd>{s.quoi}</dd>
                            </div>
                        ))
                    }
                </dl>
            </div>
        </section>

        <section class="phase rose" data-phase="rose" aria-labelledby="t-parcours">
            <div class="wrap">
                <h2 id="t-parcours">Onze ans, quatre équipes</h2>
            </div>
            <ol class="cues" role="list">
                {
                    parcours.map((p, i) => (
                        <li class={`cue cue-${i + 1}`}>
                            <div class="wrap cue-grille">
                                <p class="cue-meta">
                                    <span class="cue-num">LX 3.{i + 1}</span>
                                    <span>{p.annees}</span>
                                    <span>{p.role}</span>
                                </p>
                                <h3 class="maison">{p.maison}</h3>
                                <p class="note">{p.note}</p>
                            </div>
                            {i === parcours.length - 1 && (
                                <p class="wrap suite">
                                    Le détail de chaque poste est sur{" "}
                                    <a href="https://www.linkedin.com/in/corentin--le--gal/" rel="me noopener">LinkedIn</a>.
                                </p>
                            )}
                        </li>
                    ))
                }
            </ol>
        </section>

        <section id="projets" class="phase aube" data-phase="aube" aria-labelledby="t-projets">
            <div class="wrap">
                <h2 id="t-projets" class="visuellement-cache">Projets</h2>
                {
                    rendus.map(({ data, Contenu }) => (
                        <article class="projet" aria-labelledby={`p-${data.titre}`}>
                            <div class="projet-texte">
                                <div class="projet-titre">
                                    {data.icone && (
                                        <Image src={data.icone} alt="" width={72} height={72} class="icone" />
                                    )}
                                    <h3 id={`p-${data.titre}`}>{data.titre}</h3>
                                </div>
                                <p class="accroche">{data.accroche}</p>
                                <div class="corps">
                                    <Contenu />
                                </div>
                                {data.statut === "bientot" && data.mention && (
                                    <p class="mention">{data.mention}</p>
                                )}
                                {data.statut === "disponible" && (
                                    <p class="stores">
                                        {data.appStore && <a href={data.appStore}>App Store</a>}
                                        {data.playStore && <a href={data.playStore}>Play Store</a>}
                                    </p>
                                )}
                                <p class="projet-stack">{data.stack.join(" · ")}</p>
                                {data.site && (
                                    <a class="action" href={data.site}>
                                        {new URL(data.site).hostname.replace("www.", "")}
                                        <Fragment set:html={fleche} />
                                    </a>
                                )}
                            </div>
                            <div class="captures">
                                {data.captures.map((c, i) => (
                                    <Image
                                        src={c.src}
                                        alt={c.alt}
                                        widths={[360, 540, 720]}
                                        sizes="(max-width: 760px) 44vw, 300px"
                                        class={`capture capture-${i + 1}`}
                                        loading="lazy"
                                    />
                                ))}
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <section class="phase jour" data-phase="jour" aria-labelledby="t-cernix">
            <div class="wrap jour-grille">
                <h2 id="t-cernix">Une mission&#8239;? C'est chez Cernix</h2>
                <div class="jour-texte">
                    <p class="lead">
                        J'ai fondé Cernix, mon cabinet de conseil indépendant à Angers. J'y interviens
                        en amont des projets techniques : cadrage, architecture, arbitrages.
                    </p>
                    <a class="action action-pleine" href="https://cernix.fr">
                        cernix.fr
                        <Fragment set:html={fleche} />
                    </a>
                    <p class="reste">
                        Pour tout le reste :{" "}
                        <a href="mailto:corentin.legal@proton.me">corentin.legal@proton.me</a>
                    </p>
                </div>
            </div>
        </section>
    </main>

    <footer class="pied">
        <div class="wrap pied-ligne">
            <span class="pied-marque" set:html={monogramme} />
            <p>© 2026 Corentin Le Gal · Fondateur de{" "}<a href="https://cernix.fr">Cernix</a></p>
        </div>
    </footer>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        import Lenis from "lenis";
        import "lenis/dist/lenis.css";

        gsap.registerPlugin(ScrollTrigger);

        const racine = document.documentElement;
        const calme = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const borner = (n: number) => Math.min(1, Math.max(0, n));

        // --- Défilement : Lenis lisse la molette au rythme de GSAP. Sous prefers-reduced-motion,
        // le défilement reste natif et rien ne s'anime.
        const lenis = calme ? null : new Lenis({ autoRaf: false, anchors: true });
        if (lenis) {
            lenis.on("scroll", ScrollTrigger.update);
            gsap.ticker.add((t) => lenis.raf(t * 1000));
            gsap.ticker.lagSmoothing(0);
        }
        const defiler = (y: number, options: { duration?: number; lerp?: number } = {}) => {
            if (lenis) lenis.scrollTo(y, options);
            else scrollTo({ top: y, behavior: "instant" });
        };

        // --- Ciel : les étoiles tournent autour du pôle, comme une nuit en pose longue.
        const nuit = document.querySelector<HTMLElement>(".nuit");
        const ciel = document.querySelector<HTMLCanvasElement>(".ciel");
        const sol = document.querySelector<HTMLElement>(".sol");
        const pinceau = ciel?.getContext("2d");
        let graine = 7;
        const hasard = () => {
            graine = (graine * 16807) % 2147483647;
            return graine / 2147483647;
        };
        // Réparties uniformément sur le disque du ciel, aux mêmes places à chaque visite.
        const etoiles = Array.from({ length: 120 }, () => ({
            r: Math.sqrt(hasard()),
            a: hasard() * Math.PI * 2,
            taille: 0.6 + hasard() * 1.1,
            eclat: 0.25 + hasard() * 0.6,
        }));
        // temps et defilement en radians ; eclat fait apparaître le ciel au chargement.
        const rotation = { temps: 0, defilement: 0, eclat: calme ? 1 : 0 };
        const pole = { x: 0, y: 0 };
        let rayon = 0;
        let horizon = 0;
        let dpr = 1;

        const dessiner = () => {
            if (!ciel || !pinceau) return;
            pinceau.setTransform(dpr, 0, 0, dpr, 0, 0);
            pinceau.clearRect(0, 0, ciel.width, ciel.height);
            pinceau.fillStyle = "#f7f5ff";
            // Sens antihoraire, comme le ciel du nord.
            const tour = -(rotation.temps + rotation.defilement);
            for (const e of etoiles) {
                const x = pole.x + Math.cos(e.a + tour) * e.r * rayon;
                const y = pole.y + Math.sin(e.a + tour) * e.r * rayon;
                if (y > horizon) continue;
                pinceau.globalAlpha = e.eclat * rotation.eclat;
                pinceau.beginPath();
                pinceau.arc(x, y, e.taille, 0, Math.PI * 2);
                pinceau.fill();
            }
        };

        const dimensionner = () => {
            if (!nuit || !ciel || !sol) return;
            dpr = Math.min(devicePixelRatio, 2);
            const { width, height } = nuit.getBoundingClientRect();
            ciel.width = width * dpr;
            ciel.height = height * dpr;
            horizon = sol.offsetTop;
            // Le pôle est haut dans le ciel, au-dessus du nom. Le disque couvre tout le ciel
            // visible, quel que soit l'angle.
            pole.x = width * 0.5;
            pole.y = horizon * 0.35;
            rayon = Math.hypot(Math.max(pole.x, width - pole.x), Math.max(pole.y, horizon - pole.y));
            dessiner();
        };
        if (nuit) new ResizeObserver(dimensionner).observe(nuit);

        // --- Lever de la nuit : la nappe se lève, la poursuite s'allume puis traverse
        // l'horizon sans fin, les étoiles apparaissent et tournent. Le défilement accentue tout.
        if (!calme && nuit) {
            gsap.set([".lumiere-horizon", ".nappe", ".poursuite"], { transformOrigin: "50% 100%" });
            gsap.timeline()
                .fromTo(".nappe", { opacity: 0, scaleY: 0.1 }, { opacity: 1, scaleY: 1, duration: 3.2, ease: "expo.out" })
                .fromTo(".poursuite", { opacity: 0 }, { opacity: 1, duration: 3, ease: "power1.inOut" }, 0.8)
                .to(rotation, { eclat: 1, duration: 2.5, ease: "power1.inOut" }, 0.4)
                .fromTo(".console", { autoAlpha: 0, x: 24 }, { autoAlpha: 1, x: 0, duration: 1.2, ease: "expo.out" }, 1);
            gsap.fromTo(".poursuite", { xPercent: -50 }, { xPercent: 0, duration: 70, ease: "none", repeat: -1 });

            const montee = { trigger: nuit, start: "top top", end: "bottom top", scrub: 1 };
            // La nappe tient 40 % de la nuit en haut de page et monte à 60 %. Le filtre part de
            // valeurs explicites : depuis « none », GSAP interpolerait depuis brightness(0).
            gsap.fromTo(
                ".lumiere-horizon",
                { scaleY: 40 / 60, filter: "saturate(1) brightness(1)" },
                { scaleY: 1, filter: "saturate(1.3) brightness(1.25)", ease: "none", scrollTrigger: montee },
            );
            gsap.to(".poursuite", { scaleX: 1.6, scaleY: 1.3, ease: "none", scrollTrigger: montee });
            gsap.to(rotation, { defilement: 0.5, ease: "none", scrollTrigger: montee });

            // Un tour en neuf minutes environ ; on ne dessine que si la nuit est à l'écran.
            let visible = true;
            ScrollTrigger.create({
                trigger: nuit,
                start: "top bottom",
                end: "bottom top",
                onToggle: (st) => {
                    visible = st.isActive;
                },
            });
            gsap.ticker.add((_, dt) => {
                if (!visible) return;
                rotation.temps += (dt / 1000) * 0.012;
                dessiner();
            });
        }

        // --- Console : le pupitre affiche la phase dont la lumière occupe le haut de l'écran,
        // le fader suit le défilement et le pilote.
        const phases = [...document.querySelectorAll<HTMLElement>("[data-phase]")].filter((el) => el !== racine);
        const q = document.querySelector(".conduite-q");
        const fader = document.querySelector<HTMLElement>(".fader");
        const bouton = document.querySelector<HTMLElement>(".fader-bouton");

        let course = 1;
        let prises: number[] = [];
        let courante = -1;

        // Une cue par phase ; un clic y amène la page.
        const cues = phases.map((_, i) => {
            const li = document.createElement("li");
            li.textContent = `LX ${i + 1}`;
            // Un pixel après la prise : Lenis arrondit et s'arrêterait juste avant la phase.
            li.addEventListener("click", () => defiler(Math.min(prises[i] + 1, course), { duration: 1.6 }));
            return li;
        });
        document.querySelector(".fader-cues")?.append(...cues);

        const maj = () => {
            const p = borner(scrollY / course);
            fader?.style.setProperty("--p", String(p));
            fader?.setAttribute("aria-valuenow", String(Math.round(p * 100)));
            const i = Math.max(0, prises.findLastIndex((prise) => scrollY >= prise));
            if (i === courante) return;
            const sens = i > courante ? 1 : -1;
            const premiere = courante === -1;
            courante = i;
            racine.dataset.phase = phases[i].dataset.phase;
            cues.forEach((li, j) => li.classList.toggle("active", j === i));
            if (!q) return;
            if (premiere || calme) {
                q.textContent = `LX ${i + 1}`;
                return;
            }
            // Le numéro roule dans le pupitre pendant que la couleur change : l'ancien sort dans
            // le sens du défilement, le nouveau entre derrière lui.
            gsap.timeline({ overwrite: true })
                .to(q, { yPercent: -110 * sens, duration: 0.2, ease: "power2.in" })
                .set(q, { textContent: `LX ${i + 1}`, yPercent: 110 * sens })
                .to(q, { yPercent: 0, duration: 0.5, ease: "expo.out" });
        };

        // Où chaque phase prend la main : quand les trois cinquièmes de son fondu de lumière ont
        // passé le haut de l'écran. Sa cue se pose au même endroit sur la course du fader.
        const mesurer = () => {
            course = Math.max(1, racine.scrollHeight - innerHeight);
            prises = phases.map((p) => {
                const fondu = p.tagName === "HEADER" ? 0 : Number.parseFloat(getComputedStyle(p).paddingTop) * 0.6;
                const prise = p.getBoundingClientRect().top + scrollY + fondu - 48;
                // En bas de page, la dernière phase (courte) n'atteint jamais le seuil.
                return Math.max(0, Math.min(prise, course - 2));
            });
            cues.forEach((li, i) => li.style.setProperty("--p", String(prises[i] / course)));
            maj();
        };

        // Le fader : un clic sur la course y amène la page, le bouton se saisit et se glisse.
        let ecart = 0;
        const niveau = (clientY: number) => {
            if (!fader || !bouton) return 0;
            const r = fader.getBoundingClientRect();
            const demi = bouton.offsetHeight / 2;
            return borner((clientY - ecart - r.top - demi) / (r.height - 2 * demi)) * course;
        };
        fader?.addEventListener("pointerdown", (e) => {
            if (e.button !== 0 || (e.target as Element).closest("li")) return;
            const surBouton = e.target === bouton;
            const centre = bouton ? bouton.getBoundingClientRect().top + bouton.offsetHeight / 2 : 0;
            ecart = surBouton ? e.clientY - centre : 0;
            fader.setPointerCapture(e.pointerId);
            fader.classList.add("tenu");
            if (!surBouton) defiler(niveau(e.clientY), { duration: 0.9 });
        });
        fader?.addEventListener("pointermove", (e) => {
            const r = fader.getBoundingClientRect();
            const demi = bouton ? bouton.offsetHeight / 2 : 0;
            const y = Math.min(r.height - demi, Math.max(demi, e.clientY - r.top));
            fader.style.setProperty("--y", `${y}px`);
            if (fader.hasPointerCapture(e.pointerId)) defiler(niveau(e.clientY), { lerp: 0.25 });
        });
        const lacher = () => fader?.classList.remove("tenu");
        fader?.addEventListener("pointerup", lacher);
        fader?.addEventListener("pointercancel", lacher);

        addEventListener("scroll", maj, { passive: true });
        // Polices, images et redimensionnement changent la hauteur des phases.
        new ResizeObserver(mesurer).observe(document.body);
    </script>
</Layout>

<style>
    .evitement {
        position: absolute;
        left: var(--page);
        top: -80px;
        z-index: 20;
        background: var(--blanc);
        color: var(--e-sombre);
        padding: 10px 16px;
        font-weight: 600;
    }

    .evitement:focus {
        top: 16px;
    }

    /* --- Console : le pupitre de conduite et le fader, à la lumière de la phase en cours ---
       Seulement sur grand écran avec une souris : ailleurs, la barre native suffit. */
    .console {
        display: none;
    }

    /* Les chiffres de conduite en Albert Sans : au pochoir, le 1 se lit comme un I. */
    .conduite-q,
    .repere-num,
    .cue-num,
    .fader-cues {
        font-family: var(--texte);
        font-weight: 600;
        letter-spacing: 0.02em;
        font-variant-numeric: tabular-nums;
    }

    @media (min-width: 1200px) and (pointer: fine) {
        :global(html) {
            scrollbar-width: none;
        }

        .console {
            --c-fond: var(--nuit);
            --c-encre: var(--e-clair);
            --c-filet: rgb(247 245 255 / 0.3);
            --axe: 18px;
            --demi: 20px;
            position: fixed;
            z-index: 10;
            top: 20px;
            bottom: 20px;
            right: clamp(0px, calc(var(--page) - 64px), 24px);
            width: 64px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 20px;
            color: var(--c-encre);
            transition: color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        :global(html[data-phase="cobalt"]) .console {
            --c-fond: var(--cobalt);
        }

        :global(html[data-phase="rose"]) .console,
        :global(html[data-phase="aube"]) .console,
        :global(html[data-phase="jour"]) .console {
            --c-encre: var(--e-sombre);
            --c-filet: rgb(11 13 26 / 0.3);
        }

        :global(html[data-phase="rose"]) .console {
            --c-fond: var(--rose);
        }

        :global(html[data-phase="aube"]) .console {
            --c-fond: var(--aube);
        }

        :global(html[data-phase="jour"]) .console {
            --c-fond: var(--jour);
        }

        /* Le pupitre, au-dessus de la course : le numéro de la phase, qui roule dans sa fenêtre. */
        .conduite {
            flex: none;
